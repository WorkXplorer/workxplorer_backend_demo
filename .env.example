# Copy this file to .env.development and fill in real values for local development.
# See README.md for the full setup walkthrough.

DJANGO_ENVIRONMENT=development

# Django
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# Database (PostgreSQL with the pgvector extension enabled)
DB_NAME=workxplorer_demo
DB_USER=workxplorer_demo
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis (cache + RQ background task queue)
REDIS_URL=redis://127.0.0.1:6379/0

# AI provider - optional locally; AI-powered features are disabled without it
AI_API_KEY=
AI_MODEL=
AI_API_BASE_URL=

# Firebase Cloud Messaging (push notifications) - optional locally
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
