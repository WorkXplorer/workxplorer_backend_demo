msgid "Vacancy created successfully via AI."
msgstr "Vakansiya AI orqali muvaffaqiyatli yaratildi."

#: apps/ai/views/ai_action.py:218
msgid "Recruiter must be associated with a company to create vacancies"
msgstr "Rekruter vakansiya yaratish uchun kompaniyaga bog'langan bo'lishi kerak"

#: apps/ai/views/ai_action.py:223 apps/vacancies/views/crud.py:76
