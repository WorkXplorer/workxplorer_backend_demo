msgid "Failed to fetch vacancy from the provided URL."
msgstr "Berilgan URL manzilidan vakansiyani yuklab bo'lmadi."

#: apps/ai/views/ai_action.py:186
msgid "Vacancy creation failed."
msgstr "Vakansiya yaratish muvaffaqiyatsiz"

