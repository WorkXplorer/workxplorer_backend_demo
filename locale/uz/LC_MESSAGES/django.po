msgid "Only administrators can validate skills."
msgstr "Faqat administratorlar ko'nikmalarni tasdiqlashi mumkin."

#: apps/ai/views/ai_action.py:115
msgid "Only recruiters can create vacancies."
msgstr "Faqat rekruterlar vakansiyalar yaratishi mumkin"

#: apps/ai/views/ai_action.py:125
msgid ""
"The selected AI provider is not properly configured. Please check the API "
"key in settings."
msgstr ""
"Tanlangan AI provayder to'g'ri sozlanmagan. Iltimos, sozlamalardan API "
"kalitini tekshiring."

#: apps/ai/views/ai_action.py:146
msgid "AI validation failed."
msgstr "AI tekshiruvi muvaffaqiyatsiz"

#: apps/ai/views/ai_action.py:152
msgid "Validation completed."
msgstr "Tekshirish yakunlandi"

