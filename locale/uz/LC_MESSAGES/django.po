msgid ""
"\n"
"Dry run mode - no changes will be made."
msgstr ""
"\n"
"Sinov rejimi - hech qanday o'zgartirish kiritilmaydi."

#: apps/applications/management/commands/reset_application_statuses.py:77
msgid "Deleted {} existing statuses."
msgstr "{} ta mavjud status o'chirildi."

#: apps/applications/management/commands/reset_application_statuses.py:84
msgid "Created {} new statuses from template."
msgstr "Shablondan {} ta yangi status yaratildi."

