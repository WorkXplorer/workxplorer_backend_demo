#: apps/applications/models/applications.py:541
#, python-brace-format
msgid "Application is already in status '{status}'."
msgstr "Ariza allaqachon '{status}' holatida."

#: apps/applications/models/applications.py:550
#, python-brace-format
msgid ""
"Candidates can only withdraw an application, not change it to '{target}'."
msgstr ""
"Nomzodlar arizani faqat qaytarib olishlari mumkin, uni '{target}' holatiga "
"o‘zgartira olmaydi."

#: apps/applications/models/applications.py:561
msgid ""
"Cannot change status of a withdrawn application. Only the candidate can "
"reapply."
msgstr ""
"Qaytarib olingan arizaning holatini o'zgartirib bo'lmaydi. Faqat nomzod "
"qayta topshirishi mumkin."

#: apps/applications/models/applications.py:568
#, python-brace-format
msgid ""
"Cannot manually move to '{target}' — this status is set only by AI "
"evaluation."
msgstr ""
"'{target}' holatiga qo'lda o'zgartirib bo'lmaydi — bu holat faqat AI "
"baholashi orqali o'rnatiladi."

#: apps/applications/models/applications.py:576
#, python-brace-format
msgid ""
"Cannot manually move from '{current}' — revaluation is done via the AI re-"
"evaluation endpoint."
msgstr ""
"'{current}' dan qo'lda o'zgartirib bo'lmaydi — qayta baholash AI re-"
"evaluation endpointi orqali amalga oshiriladi."

#: apps/applications/models/applications.py:585
#, python-brace-format
msgid "Cannot reject from '{current}' — this is a terminal status."
msgstr "'{current}' holatidan rad etib bo'lmaydi — bu yakuniy holat."

#: apps/applications/models/applications.py:674
msgid "None"
msgstr "Yo'q"

#: apps/applications/models/applications.py:677
#, python-brace-format
msgid ""
"{user_type} cannot change status from '{current}' to '{new_status}'. Allowed "
"transitions: {allowed}"
msgstr ""
"{user_type} holat '{current}' dan '{new_status}' ga o'zgartirib bo'lmaydi. "
"Ruxsat etilgan o'tishlar: {allowed}"

