msgid "Company {} has no existing statuses."
msgstr "{} kompaniyasida mavjud statuslar yo'q."

#: apps/applications/management/commands/reset_application_statuses.py:52
msgid "No default status template found. Please create one first."
msgstr "Standart status shabloni topilmadi. Iltimos, avval birini yarating."

