msgid "The 'status' query parameter is required."
msgstr "'status' so'rov parametri majburiy."

#: apps/ai/views/ai_action.py:69
msgid "This parameter is mandatory. Supported value: 'passive_skills'."
msgstr "Bu parametr majburiy. Qo'llab-quvvatlanadigan qiymat: 'passive_skills'."

#: apps/ai/views/ai_action.py:83
msgid "Passive skills retrieved successfully."
msgstr "Passiv ko'nikmalar muvaffaqiyatli olindi"

#: apps/ai/views/ai_action.py:87
msgid "Invalid status parameter."
msgstr "Noto'g'ri status parametri"

#: apps/ai/views/ai_action.py:89
msgid "Only 'passive_skills' is currently supported."
msgstr "Hozirda faqat 'passive_skills' qo'llab-quvvatlanadi."

