#: apps/applications/models/applications.py:541
#, python-brace-format
msgid "Application is already in status '{status}'."
msgstr "Заявка уже находится в статусе '{status}'."

#: apps/applications/models/applications.py:550
#, python-brace-format
msgid ""
"Candidates can only withdraw an application, not change it to '{target}'."
msgstr ""
"Кандидаты могут только отозвать заявку, а не изменить её на '{target}'."

#: apps/applications/models/applications.py:561
msgid ""
"Cannot change status of a withdrawn application. Only the candidate can "
"reapply."
msgstr ""
"Нельзя изменить статус отозванной заявки. Только кандидат может подать её "
"повторно."

